# Copy this file to .env and fill in the values.

# SQLite database file, relative to the project root.
# To move to PostgreSQL later, swap the provider in prisma/schema.prisma,
# install @prisma/adapter-pg, and point this at your Postgres connection string.
DATABASE_URL="file:./dev.db"

# Signing key for session cookies. Must be at least 32 characters.
# Generate one with:  node -e "require('fs').appendFileSync('.env','\nAUTH_SECRET='+require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Where uploaded documents are written. Keep this outside the public folder.
UPLOAD_DIR="./storage/uploads"
