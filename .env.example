# Copy this file to .env and fill in the values.

# SQLite database file, relative to the project root.
# To move to PostgreSQL later, swap the provider in prisma/schema.prisma,
# install @prisma/adapter-pg, and point this at your Postgres connection string.
DATABASE_URL="file:./dev.db"

# Signing key for session cookies. Must be at least 32 characters.
# Generate one with:  node -e "require('fs').appendFileSync('.env','\nAUTH_SECRET='+require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Where uploaded documents are written. Keep this outside the public folder.
UPLOAD_DIR="./storage/uploads"

# ---------------------------------------------------------------- AI screening
# Azure OpenAI, used to score resumes against a job description. Screening is
# disabled and the UI says so if AZURE_OPENAI_API_KEY is absent, so these are
# optional for local development.
# Resource host only — no path. Both the classic *.openai.azure.com and the
# Foundry *.services.ai.azure.com hosts work; the client appends the rest.
AZURE_OPENAI_ENDPOINT="https://<your-resource>.services.ai.azure.com"
AZURE_OPENAI_API_KEY=""
# The deployment name you created in Azure AI Foundry, not the base model name.
# Must be vision-capable (e.g. gpt-4.1-mini, gpt-4o) so image resumes can be
# read, and must support structured outputs.
AZURE_OPENAI_DEPLOYMENT="gpt-4.1-mini"
AZURE_OPENAI_API_VERSION="2024-10-21"
